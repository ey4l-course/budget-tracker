<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="true">

    <!-- ================================================================ -->
    <!--  PROPERTIES                                                       -->
    <!-- ================================================================ -->
    <springProperty scope = "context" name = "SERVICE_NAME" source = "server.name" defaultValue = "unknown-service" />
    <property name="LOG_DIR" value="${HOME}/logs" />
    <property name="MAX_FILE_SIZE" value="10MB" />
    <property name="MAX_HISTORY" value="30" />

    <!-- ================================================================== -->
    <!--  2. JSON ENCODER FOR SIEM                                          -->
    <!-- ================================================================== -->
    <!-- Produces one JSON log entry per line (ELK-friendly) -->

    <appender name="SEC_JSON_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/${SERVICE_NAME}-security.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/${SERVICE_NAME}-security.%d{yyyy-MM-dd}.%i.gz</fileNamePattern>
            <maxFileSize>${MAX_FILE_SIZE}</maxFileSize>
            <maxHistory>${MAX_HISTORY}</maxHistory>
        </rollingPolicy>
            <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
                <providers>
                    <timestamp>
                        <timeZone>UTC</timeZone>
                        <pattern>yyyy-MM-dd'T'HH:mm:ss.SSS'Z'</pattern>
                    </timestamp>
                    <logLevel />
                    <threadName />
                    <loggerName />
                    <message />
                    <context />
                    <mdc />
                    <arguments />
                </providers>
        </encoder>
    </appender>


    <!-- ================================================================ -->
    <!--  FULL ERROR STACKTRACE FILE (ONLY unexpected errors)             -->
    <!-- ================================================================ -->
    <appender name="FULL_ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/${SERVICE_NAME}-errors.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/${SERVICE_NAME}-errors.%d{yyyy-MM-dd}.%i.gz</fileNamePattern>
            <maxFileSize>${MAX_FILE_SIZE}</maxFileSize>
            <maxHistory>${MAX_HISTORY}</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>
                %d{yyyy-MM-dd'T'HH:mm:ss.SSS'Z'} %-5level %logger{36} - %msg%n%ex{full,
                org.springframework,
                org.apache.catalina,
                org.apache.coyote,
                org.apache.tomcat,
                jakarta.servlet,
                java.base,
                jdk.internal}%n
            </pattern>
        </encoder>
    </appender>


    <!-- Async to avoid blocking database / controller threads -->
    <appender name="ASYNC_FULL_ERROR" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>5000</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <appender-ref ref="FULL_ERROR_FILE"/>
    </appender>

    <!-- ================================================================ -->
    <!--  CONSOLE LOG (for development only)                              -->
    <!-- ================================================================ -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- ================================================================ -->
    <!--  LOGGERS                                                         -->
    <!-- ================================================================ -->

    <logger name="SEC" level="INFO" additivity="false">
        <appender-ref ref="SEC_JSON_FILE" />
    </logger>

    <!-- LogUtil writes to this logger for unexpected errors -->
    <logger name="fullErrorLogger" level="ERROR" additivity="false">
        <appender-ref ref="ASYNC_FULL_ERROR"/>
    </logger>

    <!-- Everything else → console only -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

</configuration>
