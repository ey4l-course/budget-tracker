<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="true">

    <!-- ================================================================ -->
    <!--  PROPERTIES                                                       -->
    <!-- ================================================================ -->
    <property name="LOG_DIR" value="${HOME}/logs" />
    <property name="MAX_FILE_SIZE" value="10MB" />
    <property name="MAX_HISTORY" value="30" />

    <!-- ================================================================ -->
    <!--  FULL ERROR STACKTRACE FILE (ONLY unexpected errors)             -->
    <!-- ================================================================ -->
    <appender name="FULL_ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/users-errors.log</file>

        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/users-errors.%d{yyyy-MM-dd}.%i.gz</fileNamePattern>
            <maxFileSize>${MAX_FILE_SIZE}</maxFileSize>
            <maxHistory>${MAX_HISTORY}</maxHistory>
        </rollingPolicy>

        <encoder>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSS'Z'} %-5level %logger{36} - %msg%n%ex%n</pattern>
        </encoder>
    </appender>

    <!-- Async to avoid blocking database / controller threads -->
    <appender name="ASYNC_FULL_ERROR" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>5000</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <appender-ref ref="FULL_ERROR_FILE"/>
    </appender>

    <!-- ================================================================ -->
    <!--  CONSOLE LOG (for development only)                              -->
    <!-- ================================================================ -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- ================================================================ -->
    <!--  LOGGERS                                                         -->
    <!-- ================================================================ -->

    <!-- LogUtil writes to this logger for unexpected errors -->
    <logger name="fullErrorLogger" level="ERROR" additivity="false">
        <appender-ref ref="ASYNC_FULL_ERROR"/>
    </logger>

    <!-- Everything else → console only -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

</configuration>
